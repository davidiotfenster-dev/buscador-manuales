# =============================================================================
# Buscador de Manuales MySmartWindow — Variables de Entorno
# =============================================================================
# Copia este archivo a .env y configura los valores para tu entorno.
# docker-compose leerá automáticamente el archivo .env

# --- Base de Datos ---
POSTGRES_PASSWORD=una_contraseña_segura_aqui

# --- Seguridad JWT ---
# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Duración del token en minutos (default: 1440 = 24 horas)
TOKEN_EXPIRE_MINUTES=1440

# --- Admin ---
# Contraseña para el usuario admin por defecto (se genera aleatoriamente si no se configura)
ADMIN_DEFAULT_PASSWORD=

# --- Subida de archivos ---
# Tamaño máximo de PDF en MB (default: 50)
MAX_UPLOAD_SIZE_MB=50

# --- YouTube ---
# Intervalo de sincronización automática en horas (default: 24)
YOUTUBE_SYNC_INTERVAL_HOURS=24

# --- Correo saliente (partes SAT) ---
# Sin estas tres, la aplicación NO envía ningún parte: genera el PDF, avisa de
# que no ha salido y lo deja ahí. No es un fallo silencioso, pero tampoco es un
# envío. Hasta rellenarlas, el parte hay que hacerlo llegar a mano.
#
# Con Google Workspace, SMTP_PASSWORD es una contraseña de aplicación, no la
# del buzón: https://support.google.com/accounts/answer/185833
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=soporte@iotfenster.com
SMTP_FROM_NAME=Soporte Técnico IoT Fenster
